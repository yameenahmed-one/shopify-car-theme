<!-- Customer Account Dashboard -->
<section class="customer-account">
  <div class="container">
    <div class="account-header">
      <h1>My Account</h1>
      <a href="/account/logout" class="btn btn-secondary">Sign Out</a>
    </div>

    <div class="account-content">
      <!-- Account Information -->
      <div class="account-section">
        <h2>Account Information</h2>
        <div class="account-info">
          <p><strong>Name:</strong> {{ customer.first_name }} {{ customer.last_name }}</p>
          <p><strong>Email:</strong> {{ customer.email }}</p>
          <a href="/account/addresses" class="link">Manage Addresses</a>
        </div>
      </div>

      <!-- Order History -->
      <div class="account-section">
        <h2>Order History</h2>
        {% if customer.orders.size > 0 %}
          <table class="orders-table">
            <thead>
              <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.order_number }}</a></td>
                  <td>{{ order.created_at | date: "%B %d, %Y" }}</td>
                  <td>{{ order.total_price | money }}</td>
                  <td>{{ order.financial_status_label }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p>You haven't placed any orders yet.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .customer-account {
    padding: 60px 20px;
    background: #f9f9f9;
  }
  
  .account-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }
  
  .account-section {
    background: white;
    padding: 30px;
    margin-bottom: 30px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .orders-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .orders-table th,
  .orders-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  
  .orders-table th {
    background: #f5f5f5;
    font-weight: 600;
  }
</style>
